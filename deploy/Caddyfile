{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# No access log here: vaultaged logs each request, and Caddy would log the X-Coffer-Enroll header.
{$VAULTAGE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	# MAX_JSON_BODY is 32 MiB.
	request_body {
		max_size 33MiB
	}
	reverse_proxy {$VAULTAGE_UPSTREAM:vaultaged:8787}
}
